{
  "name": "portfolio-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check:dependency-build-policy": "node scripts/check-dependency-build-policy.mjs && node --test tests/node/source-map-offsets.test.mjs && node --test tests/node/brace-expansion.test.mjs && node --test tests/node/sharp-svg-security.test.mjs",
    "clean": "rm -rf .turbo apps/*/.turbo packages/*/.turbo apps/web/out apps/web/.next",
    "prepare": "husky"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.0.0",
    "turbo": "^2.11.2"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ]
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ],
    "overrides": {
      "postcss@<8.5.23": "8.5.23",
      "tar@<=7.5.20": "7.5.21",
      "flatted@<=3.4.1": "3.4.2",
      "picomatch@<2.3.2": "2.3.2",
      "brace-expansion@<2.0.0": "1.1.21",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.7",
      "next@>=16.0.0 <16.3.3": "16.3.4",
      "baseline-browser-mapping@<2.11.0": "2.11.0",
      "browserslist@<4.28.7": "4.28.7",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "source-map-js@<1.2.2": "1.2.2",
      "sharp@<0.35.5": "0.35.5"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@10.34.5"
}
