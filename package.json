{
  "name": "portfolio-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check:dependency-build-policy": "node scripts/check-dependency-build-policy.mjs",
    "clean": "rm -rf .turbo apps/*/.turbo packages/*/.turbo apps/web/out apps/web/.next",
    "prepare": "husky"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.0.0",
    "turbo": "^2.10.4"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ]
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@tailwindcss/oxide",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss@<8.5.23": "8.5.23",
      "tar@<=7.5.20": "7.5.21",
      "flatted@<=3.4.1": "3.4.2",
      "picomatch@<2.3.2": "2.3.2",
      "sharp@<0.35.0": "0.35.0",
      "next@>=16.0.0 <16.2.11": "16.2.11",
      "brace-expansion@<2.0.0": "1.1.18",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
      "brace-expansion@>=4.0.0 <5.0.8": "5.0.9"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@10.34.5"
}
